%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e1a0f60abaa4759878657d50d70b112, type: 3}
  m_Name: Special Keyword
  m_EditorClassIdentifier: 
  specialKeywordBaseList:
  - specialKeyword: 0
    header: Block
    contentText: Absorb <color=#FFB430>{Block}</color> incoming damage. <color=#FFB430>Temporary</color>.
  - specialKeyword: 1
    header: Strength
    contentText: Increase the <color=#FFB430>Base</color> damage of attacks by <color=#FFB430>{Strength}</color>.
  - specialKeyword: 4
    header: Light
    contentText: WIthout it, the power of your lantern diminishes.
  - specialKeyword: 7
    header: Bleeding
    contentText: At the end of the turn, take <color=#FFB430>{Bleeding}</color> damage
      and increase <color=#FFB430>Bleeding</color> by <color=#FFB430>1</color>.
  - specialKeyword: 3
    header: Exhaust
    contentText: Remove this card from your deck for the rest of the combat.
  - specialKeyword: 5
    header: Stun
    contentText: <color=#FFB430>Unable</color> to take action.
  - specialKeyword: 6
    header: Fragile
    contentText: Take <color=#FFB430>{Fragile*10}%</color> more damage.
  - specialKeyword: 8
    header: Pursuit
    contentText: Perform an extra <color=#FFB430>{Pursuit}</color> damage attack
      when launching an attack instance.
  - specialKeyword: 9
    header: Ward
    contentText: Consume <color=#FFB430>1</color> stack to negate an incoming <color=#FFB430>Infliction</color>.
  - specialKeyword: 10
    header: Cantrip
    contentText: Next card played has it's cost reduced to <color=#FFB430>0</color>.
      (<color=#FFB430>Unstackable</color>).
  - specialKeyword: 11
    header: Nephilim
    contentText: Refund <color=#FFB430>1 Mana</color> and gain <color=#FFB430>1 Health</color>
      when using <color=#FFB430>2+</color> cost <color=#FFB430>Mana</color> cards.
      (<color=#FFB430>Unstackable</color>).
  - specialKeyword: 2
    header: Poison
    contentText: At the end of the turn, take <color=#FFB430>{Poison} Piercing</color>
      damage.
  - specialKeyword: 12
    header: Bloodletting
    contentText: "Deal bonus damage equal to the target\u2019s <color=#FFB430>Bleeding</color>."
  - specialKeyword: 13
    header: Detonate
    contentText: "Deal damage equal to <color=#FFB430>3\xD7</color> a status\u2019s
      value, then remove all its stacks."
  - specialKeyword: 14
    header: Armor
    contentText: Consume <color=#FFB430>1</color> stack to nulify an attack instance.
  - specialKeyword: 15
    header: Frostbite
    contentText: 'At the end of the turn, take <color=#FFB430>{Frostbite*25}%</color>
      of <color=#FFB430>Proficiency</color> as <color=#FFB430>Piercing</color> damage.

      Consume
      <color=#FFB430>5</color> stacks to inflict <color=#FFB430>Frozen</color>.'
  - specialKeyword: 16
    header: Burning
    contentText: 'At the end of the turn, take <color=#FFB430>{Burning*25}%</color>
      of <color=#FFB430>Proficiency</color> as <color=#FFB430>Piercing</color> damage.

      Consume
      <color=#FFB430>5</color> stacks to inflict <color=#FFB430>Combustion</color>.'
  - specialKeyword: 18
    header: Combustion
    contentText: Deal damage equal to (<color=#FFB430>Strength + 5x Proficiency</color>
      and apply <color=#FFB430>1 Burning</color> to <color=#FFB430>All</color> enemies.
  - specialKeyword: 17
    header: Frozen
    contentText: <color=#FFB430>Unable</color> to take action. The next instance
      of damage taken is increased by <color=#FFB430>50%</color>. <color=#FFB430>Taking</color>
      damage removes this status.
  - specialKeyword: 19
    header: Fortitude
    contentText: Increase the <color=#FFB430>Base</color> Block granted by actions
      by <color=#FFB430>{Fortitude}</color>.
  - specialKeyword: 20
    header: Frozen Mirror
    contentText: When attacked, apply <color=#FFB430>1 Frostbite</color> to the attacker.
  - specialKeyword: 21
    header: Blazing Surge
    contentText: When attacked, apply <color=#FFB430>1 Burning</color> to the attacker.
  - specialKeyword: 22
    header: Perfect harmony
    contentText: <color=#FFB430>"Slash"</color> will apply  <color=#FFB430>1 Burning</color>
      and  <color=#FFB430>1 Frostbite</color>. (<color=#FFB430>Unstackable</color>).
  - specialKeyword: 23
    header: Commit
    contentText: <color=#FFB430>Cost</color> is equal to your  <color=#FFB430>Max
      Mana</color>.
  - specialKeyword: 24
    header: Entrenched
    contentText: At the start of each turn, retain up to <color=#FFB430>{SteadyBarricade*10}
      Block</color>.
  - specialKeyword: 25
    header: The Mastermind
    contentText: At the start of each turn, draw <color=#FFB430>{Mastermind}</color>
      additional cards.
  - specialKeyword: 26
    header: Weakness
    contentText: 'Deal <color=#FFB430>30%</color> less damage.

      Further reduced
      by <color=#FFB430>{Weak*2}%</color>.'
  - specialKeyword: 27
    header: Judged
    contentText: Damage taken will ignore <color=#FFB430>Block</color> and <color=#FFB430>Armor</color>.
  - specialKeyword: 28
    header: Shield-Plated Blade
    contentText: 'When attacking:

      Deal bonus damage equal to <color=#FFB430>{TheBestDefense*20}%
      Block</color>.

      Lose <color=#FFB430>{TheBestDefense*10}% Block</color>.'
  - specialKeyword: 29
    header: Blinded
    contentText: Cards drawn this turn are <color=#FFB430>Indistinguishable</color>.
  - specialKeyword: 30
    header: Sabotaged
    contentText: When attacking, consume <color=#FFB430>1</color> stack to inflict
      <color=#FFB430>{Sabotaged}</color> damage to self.
  - specialKeyword: 31
    header: Hazy
    contentText: This card is removed from your deck at the end of combat.
  - specialKeyword: 32
    header: Slimed
    contentText: 'whenever you play a card, increase stack by <color=#FFB430>1</color>.

      Deal
      <color=#FFB430>25%</color> less damage for every <color=#FFB430>3</color> stacks
      of <color=#FFB430>Slimed</color>. <color=#FFB430>Temporary</color>.'
  - specialKeyword: 33
    header: Temporary
    contentText: <color=#FFB430>Clears</color> itself at the end of a turn.
  - specialKeyword: 35
    header: Deadstock
    contentText: Increase damage dealt by <color=#FFB430>{Deadstock*5}%</color> for
      each card in the <color=#FFB430>Exhaust</color> pile.
  - specialKeyword: 36
    header: Endless Chambers
    contentText: Add <color=#FFB430>{EndlessChambers * 1}</color> "<color=#FFB430>Quick
      Draw</color>" to your hand each turn.
  - specialKeyword: 37
    header: Firing Line
    contentText: At the end of your turn, deal <color=#FFB430>{Firing Line * 3}</color>
      damage to <color=#FFB430>All</color> enemies. Damage is multiplied by the number
      of cards in your <color=#FFB430>Exhaust</color> pile. (<color=#FFB430>Unstackable</color>).
  - specialKeyword: 38
    header: Vigilance
    contentText: At the start of your next turn, gain <color=#FFB430>{Vigilance}
      Block</color>. Then remove all <color=#FFB430>Vigilance</color>.
  - specialKeyword: 39
    header: Bastion
    contentText: At the start of each turn, gain <color=#FFB430>{Bastion} Block</color>.
  - specialKeyword: 40
    header: Reverberation
    contentText: Deal <color=#FFB430>{Reverberation}</color> damage to <color=#FFB430>All</color>
      enemies whenever you gain <color=#FFB430>Block</color>.
  - specialKeyword: 41
    header: Honor
    contentText: Damage that does not exceed your <color=#FFB430>Block</color> does
      not consume it.
  - specialKeyword: 42
    header: Vanguard Stance
    contentText: '- Cost 0 <color=#FFB430>Mana</color>

      - +2 <color=#FFB430>Block</color>

      -
      Gain 1 <color=#FFB430>Honor</color>'
  - specialKeyword: 43
    header: Retain
    contentText: This card will remain in your <color=#FFB430>Hand</color> after
      the turn ends.
  - specialKeyword: 44
    header: Desperation
    contentText: Take <color=#FFB430>75%</color> less damage, deal <color=#FFB430>50%</color>
      more damage, and lose <color=#FFB430>10% of Max Health</color> at the start
      of each turn.
  - specialKeyword: 45
    header: Ambush
    contentText: <color=#FFB430>Doubles</color> the damage of the next attack.
  - specialKeyword: 48
    header: Mana Drain
    contentText: Start the turn with <color=#FFB430>{Mana Drain}</color> less mana.
  - specialKeyword: 49
    header: Burden
    contentText: Increase the cost of all cards by <color=#FFB430>1</color> for <color=#FFB430>{Burden}</color>
      turn(s).
  - specialKeyword: 50
    header: Clogged Circuits
    contentText: <color=#FFB430>Prevents</color> Mana gain from cards and effects
      for <color=#FFB430>{Clogged Circuits}</color> turn(s).
  - specialKeyword: 55
    header: Might
    contentText: Deal <color=#FFB430>50%</color> more damage for <color=#FFB430>{Might}</color>
      turn(s).
  - specialKeyword: 56
    header: Resilience
    contentText: Take <color=#FFB430>50%</color> less damage for <color=#FFB430>{Resilience}</color>
      turn(s).
  - specialKeyword: 58
    header: Cheat Death
    contentText: <color=#FFB430>Immune</color> from damage equal to or above <color=#FFB430>{Cheat
      Death}</color>.
  - specialKeyword: 59
    header: Brush Off
    contentText: <color=#FFB430>Immune</color> from damage equal to or below <color=#FFB430>{Brush
      Off}</color>.
  - specialKeyword: 57
    header: Spotlight
    contentText: <color=#FFB430>Restrict</color> your next hand, preventing half
      of cards initially drawn to be played. <color=#FFB430>Unrestricted</color>
      cards must be played before <color=#FFB430>Restricted</color> cards.
  - specialKeyword: 51
    header: Actor on Stage
    contentText: 'When taking <color=#FFB430>Fatal</color> damage:

      - <color=#FFB430>Survive</color>
      with <color=#FFB430>1</color> Health.

      - Apply <color=#FFB430>Severed
      String</color> to self.'
  - specialKeyword: 52
    header: Severed String
    contentText: <color=#FFB430>Unable</color> to take action.
  - specialKeyword: 53
    header: Ongoing Performance
    contentText: '- Starts with <color=#FFB430>+1000% Max HP</color>.

      - Lose
      <color=#FFB430>10% Max HP</color> each turn.'
  - specialKeyword: 60
    header: Assimilation
    contentText: '<color=#FFB430>+3</color> whenever <color=#FFB430>The Hexer</color>
      acts.\n<color=#FFB430>+1</color> whenever a card is played. \n<color=#FFB430>Grants</color>
      additional effects at certain thresholds:

      - 10: Gain <color=#FFB430>Block</color>
      equal to your <color=#FFB430>Proficiency</color> each turn.

      - 20: Gain
      2 <color=#FFB430>Strength</color> or <color=#FFB430>Fortitude</color> each
      turn.

      - 30: Doubles <color=#FFB430>Debuffs</color> applied by actions.

      -
      40: Gain 1 <color=#FFB430>Might</color> each turn.

      - 50: Gain <color=#FFB430>Total
      Assimilation</color>.

'
  - specialKeyword: 62
    header: Total Assimilation
    contentText: Prevents <color=#FFB430>Assimilation</color> to be reduced. \n<color=#FFB430>Debuffs</color>
      from actions will instead <color=#FFB430>Permanently</color> reduce their corresponding
      status.
  - specialKeyword: 61
    header: Amnesia
    contentText: Reduce <color=#FFB430>Proficiency</color> by <color=#FFB430>50%</color>
      for <color=#FFB430>{Amnesia}</color> turn(s).
  - specialKeyword: 63
    header: Flickering
    contentText: Disables <color=#FFB430>Light Creation</color> for <color=#FFB430>{Flickering}</color>
      turn(s).
  - specialKeyword: 64
    header: Necrosis
    contentText: If <color=#FFB430>Health</color> is equal to or lower than <color=#FFB430>{Necrosis}</color>
      at the end of the turn, immediately <color=#FFB430>die</color>.
  - specialKeyword: 65
    header: Envy
    contentText: For each <color=#FFB430>10</color> cards used in a single turn,
      gain <color=#FFB430>1 Might</color> and <color=#FFB430>1 Resilience</color>.
  - specialKeyword: 66
    header: Greed
    contentText: 'Whenever <color=#FFB430>Mana</color> is gained from cards and effects,
      gain permanent <color=#FFB430>2%</color> damage amplification.\n(Current: <color=#FFB430>{Greed
      * 2}%</color> boost) '
  - specialKeyword: 67
    header: Survival Instinct
    contentText: Gain a <color=#FFB430>10% Max HP Block</color> each time health
      drops by <color=#FFB430>25%</color>.
  - specialKeyword: 68
    header: Ego
    contentText: <color=#FFB430>20%</color> change to gain <color=#FFB430>1 Strength</color>
      when taking damage.
  - specialKeyword: 69
    header: Understanding
    contentText: "Gain bonuses based on your actions:\r\n- Gain <color=#FFB430>Block</color>\u2192<color=#FFB430>+1
      Strength</color>\r\n- Gain <color=#FFB430>Strength</color>\u2192<color=#FFB430>+5
      Damage Cut</color>\r\n- Apply <color=#FFB430>Debuff</color>\u2192<color=#FFB430>+1
      Armor</color>\r\n- Draw <color=#FFB430>Card</color>\u2192<color=#FFB430>+3
      Health</color>\r\n"
  - specialKeyword: 70
    header: Brittle
    contentText: Gain <color=#FFB430>50%</color> less <color=#FFB430>Block</color>
      for <color=#FFB430>{Brittle}</color> turn(s).
  - specialKeyword: 71
    header: Damage Cut
    contentText: Reduce incoming damage by a flat <color=#FFB430>{Damage Cut}</color>.
      Reduce <color=#FFB430>1</color> stack for each attack instance taken.
